{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 4096,
    "hostname": "localhost",
    "mdns": true,
    "mdnsDomain": "opencode.local",
    "cors": ["http://localhost:3000", "http://127.0.0.1:3000"]
  },
  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-haiku-3-5",
  "default_agent": "build",
  "shell": "powershell.exe",
  "logLevel": "INFO",
  "share": "manual",
  "autoupdate": "notify",
  "snapshot": true,
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".agents/skills"]
  },
  "permission": {
    "edit": "ask",
    "bash": { "*": "ask" },
    "external_directory": { "*": "allow" }
  },
  "formatter": false,
  "lsp": false,
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}